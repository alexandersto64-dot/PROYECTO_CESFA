# ===== I.E. 88044 — endurecimiento básico (Apache 2.4 / XAMPP) =====
Options -Indexes

# Nunca servir repositorio, dumps, migraciones, docs internos ni plantillas de config
<FilesMatch "(^\.git|\.sql$|\.md$|\.example$|\.local\.php$|composer\.(json|lock)$|\.log$|\.bak$|\.env$|^debug_.*\.txt$|^test\.php$)">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HSTS: solo se envía cuando la conexión ya es HTTPS (en localhost no hace nada)
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=15552000"
    </If>
    # Content-Security-Policy: solo recursos propios + Google Fonts, Google Maps y Formspree
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; frame-src 'self' https://www.google.com; connect-src 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'self'"
</IfModule>

# Cookies de sesión y errores (aplica con mod_php; en hosting compartido ponerlo en php.ini)
<IfModule mod_php.c>
    php_flag session.cookie_httponly 1
    php_flag session.use_strict_mode 1
    # Cookie de sesión solo por HTTPS (se activa sola cuando el sitio ya usa HTTPS)
    <If "%{HTTPS} == 'on'">
        php_flag session.cookie_secure 1
    </If>
    php_value session.cookie_samesite Lax
    php_flag expose_php off
    # En producción: display_errors off. En tu PC para desarrollar puedes ponerlo en on.
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# ===== Forzar HTTPS (no afecta a localhost / XAMPP) =====
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ===== Rendimiento: compresión y caché de archivos estáticos =====
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
</IfModule>
